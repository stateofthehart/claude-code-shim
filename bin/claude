#!/usr/bin/env bash
# claude shim: adds session management on top of the real claude CLI. Everything else is passed through.
#
#   claude rm [-y] [-n] <session>          delete a session (regular or background) and everything stored for it
#   claude mv [-n] [--from DIR] <session> <dir>
#                                          move a session so it resumes from <dir>; background sessions are
#                                          stopped, moved, and restarted in <dir> with the same id and name
#   claude mv [-n] -d <old> <new>          rename/move directory <old> to <new> and every session started in it or
#                                          below; if <old> was already moved by hand, just moves the sessions
#   claude ls [-r] [options] [DIR]         list sessions started in DIR (default .), -r includes subdirs
#   claude search [options] PATTERN...     search transcripts (claude search -h)
#   claude shim                            show shim version and which real claude it wraps
#
# <session> is a full session id, an id prefix (4+ chars), or a session name (/rename title or agent name).
# Session ids are global, so these work from any directory.
#   -y  don't ask for confirmation      -n  dry run: show what would happen, change nothing
#
# A session's files: ~/.claude/projects/<dir>/<id>.jsonl, ~/.claude/projects/<dir>/<id>/ (subagents,
# tool results, title), ~/.claude/file-history/<id>/, ~/.claude/session-env/<id>/. The project's memory/
# is shared by every session in that directory, so rm leaves it alone and mv doesn't carry it over.
set -euo pipefail

# Resolve our own location without readlink -f (not on older macOS).
_self=${BASH_SOURCE[0]}
while [ -L "$_self" ]; do
  _d=$(cd -P "$(dirname "$_self")" && pwd); _self=$(readlink "$_self")
  case "$_self" in /*) ;; *) _self=$_d/$_self ;; esac
done
SHIM_DIR=$(cd -P "$(dirname "$_self")" && pwd)
LIBEXEC=$SHIM_DIR/../libexec
# shellcheck source=../libexec/portable.sh
. "$LIBEXEC/portable.sh"
SELF=$(realpath_ "$SHIM_DIR/claude")
CLAUDE_HOME=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
PROJECTS=$CLAUDE_HOME/projects

# The real claude: first one on PATH that isn't this shim.
real_claude() {
  [ -n "${CLAUDE_SHIM_REAL:-}" ] && { echo "$CLAUDE_SHIM_REAL"; return; }
  local p IFS=:
  for p in $PATH; do
    [ -x "$p/claude" ] && [ "$(realpath_ "$p/claude")" != "$SELF" ] && { echo "$p/claude"; return; }
  done
  echo "claude shim: can't find the real claude on PATH" >&2; exit 127
}

die() { echo "claude ${cmd:-}: $*" >&2; exit 1; }
grep() { command grep "$@"; }   # bypass shell grep wrappers

# How Claude Code names a project dir: every non-alphanumeric character becomes '-'.
encode() { sed 's#[^A-Za-z0-9]#-#g' <<<"$1"; }

# Print the transcript path for a session spec, or die (listing candidates if ambiguous).
# FROM (a project dir path), when set, picks among copies of the same session stored in several dirs.
resolve() {
  local q=$1 hits=()
  shopt -s nullglob
  if [[ $q =~ ^[0-9a-f-]{4,36}$ ]]; then
    hits=("$PROJECTS"/*/"$q"*.jsonl)
  fi
  if [ ${#hits[@]} -eq 0 ]; then
    local qj; qj=$(jq -Rr @json <<<"$q")
    local h
    while IFS= read -r h; do [ -n "$h" ] && hits+=("$h"); done \
      < <(grep -lF -e "\"customTitle\":$qj" -e "\"agentName\":$qj" "$PROJECTS"/*/*.jsonl 2>/dev/null || true)
    if [ ${#hits[@]} -eq 0 ]; then   # names only in the live registry (auto-derived ones)
      local sid
      sid=$(jq -r --arg n "$q" 'select(.name == $n) | .sessionId' "$CLAUDE_HOME"/sessions/*.json 2>/dev/null | head -1)
      [ -n "$sid" ] && hits=("$PROJECTS"/*/"$sid".jsonl)
    fi
  fi
  shopt -u nullglob
  [ ${#hits[@]} -gt 0 ] || die "no session matches '$q'"
  if [ ${#hits[@]} -gt 1 ] && [ -n "${FROM:-}" ]; then
    local keep=() fd; fd=$PROJECTS/$(encode "$FROM")
    for h in "${hits[@]}"; do [ "$(dirname "$h")" = "$fd" ] && keep+=("$h"); done
    [ ${#keep[@]} -gt 0 ] || die "no copy of '$q' stored for $FROM"
    hits=("${keep[@]}")
  fi
  if [ ${#hits[@]} -gt 1 ]; then
    echo "claude $cmd: '$q' matches ${#hits[@]} sessions:" >&2
    for h in "${hits[@]}"; do
      echo "  $(basename "$h" .jsonl)  \"$(title_of "$h")\"  $(wc -l < "$h" | tr -d ' ') lines  $(home_dir "$h" || true)  [$(basename "$(dirname "$h")")]" >&2
    done
    echo "pick one with --from <dir it was in> (the old path works even if it no longer exists)" >&2
    exit 1
  fi
  echo "${hits[0]}"
}

title_of() {
  local t
  t=$(grep -h '"type":"custom-title"' "$1" 2>/dev/null | tail -1 | jq -r '.customTitle // empty' 2>/dev/null) || true
  [ -n "$t" ] || t=$(grep -h -m1 '"type":"ai-title"' "$1" 2>/dev/null | jq -r '.aiTitle // empty' 2>/dev/null) || true
  echo "${t:-(untitled)}"
}

first_prompt() {
  grep -m1 '"type":"user"' "$1" | jq -r '.message.content | if type=="string" then . else (map(select(.type=="text").text) | join(" ")) end' 2>/dev/null \
    | tr '\n\t' '  ' | cut -c1-100
}

# "<kind> <pid>" if the session has a live process, else empty.
live() {
  local sid=$1 f pid kind
  for f in "$CLAUDE_HOME"/sessions/*.json; do
    [ -e "$f" ] || continue
    [ "$(jq -r .sessionId "$f" 2>/dev/null)" = "$sid" ] || continue
    pid=$(jq -r .pid "$f"); kind=$(jq -r .kind "$f")
    kill -0 "$pid" 2>/dev/null && { echo "$kind $pid"; return; }
  done
}

# Name, then launch flags one per line (minus -n/--name, which we pass ourselves), from the daemon's job record.
bg_job() {  # <sid>
  local j=$CLAUDE_HOME/jobs/${1:0:8}/state.json
  [ -f "$j" ] || return 0
  jq -r '(.name // ""),
    ((.respawnFlags // []) as $f | [range(0; $f|length) as $i
      | select(($f[$i] | IN("-n","--name")) or ($i > 0 and ($f[$i-1] | IN("-n","--name"))) | not) | $f[$i]] | .[])' "$j"
}

is_background() {
  "$REAL" agents --json --all 2>/dev/null | jq -e --arg s "$1" 'any(.[]; .sessionId == $s and .kind == "background")' >/dev/null
}

# The directory a session resumes from: the recorded cwd whose encoding matches its project dir.
# Fails if there is none (the session was moved here and hasn't run since).
home_exact() {
  local f=$1 pdir c
  pdir=$(basename "$(dirname "$f")")
  while IFS= read -r c; do
    [ "$(encode "$c")" = "$pdir" ] && { echo "$c"; return; }
  done < <(grep -o '"cwd":"[^"]*"' "$f" | sed 's/^"cwd":"//;s/"$//' | awk '!seen[$0]++')
  return 1
}

# home_exact, falling back to the first recorded cwd.
home_dir() {
  home_exact "$1" || grep -m1 -o '"cwd":"[^"]*"' "$1" | sed 's/^"cwd":"//;s/"$//'
}

# Absolute path without requiring it to exist (its parent should, to get a clean path).
abspath() {
  local p=${1%/} d
  [ -n "$p" ] || p=/
  [ -d "$p" ] && { (cd "$p" && pwd); return; }
  case "$p" in /*) ;; *) p=$PWD/$p ;; esac
  d=$(cd "$(dirname "$p")" 2>/dev/null && pwd) || { echo "$p"; return; }
  echo "${d%/}/$(basename "$p")"
}

describe() {  # <transcript>
  local f=$1 sid; sid=$(basename "$f" .jsonl)
  echo "  session: $sid  \"$(title_of "$f")\""
  echo "  dir:     $(home_dir "$f")"
  echo "  last:    $(fmt_epoch "$(mtime "$f")" '%Y-%m-%d %H:%M')"
  echo "  first:   $(first_prompt "$f")"
}

session_paths() {  # <transcript> -> every path belonging to the session that exists
  local f=$1 sid p; sid=$(basename "$f" .jsonl)
  for p in "$f" "${f%.jsonl}" "$CLAUDE_HOME/file-history/$sid" "$CLAUDE_HOME/session-env/$sid"; do
    [ -e "$p" ] && echo "$p"
  done
  return 0
}

cmd_rm() {
  local yes=0 dry=0
  while [ $# -gt 0 ]; do case "$1" in -y|--yes) yes=1 ;; -n|--dry-run) dry=1 ;; -h|--help) sed -n '2,21p' "$SHIM_DIR/claude"; exit 0 ;; *) break ;; esac; shift; done
  [ $# -eq 1 ] || die "usage: claude rm [-y] [-n] <session>"
  local f sid l bg=0
  f=$(resolve "$1"); sid=$(basename "$f" .jsonl)
  l=$(live "$sid")
  is_background "$sid" && bg=1
  [ -n "$l" ] && [ $bg = 0 ] && die "session $sid is open (${l% *} pid ${l#* }); close it first"

  echo "Delete:"; describe "$f"
  [ $bg = 1 ] && echo "  background session: claude's own rm runs first (stops it, removes its worktree when safe)"
  session_paths "$f" | sed 's/^/  rm -r /'
  [ $dry = 1 ] && { echo "(dry run, nothing deleted)"; return; }
  if [ $yes = 0 ]; then
    [ -t 0 ] || die "not a terminal; pass -y to delete without asking"
    read -rp "Delete this session? [y/N] " a; [[ $a == [yY]* ]] || die "cancelled"
  fi

  [ $bg = 1 ] && "$REAL" rm "${sid:0:8}"
  session_paths "$f" | while read -r p; do rm -rf -- "$p"; done
  echo "Deleted $sid"
}

# Point the transcript's recorded cwds under <old> at <new>, so it reads as started in the new location.
rewrite_cwd() {  # <transcript> <old> <new>
  local f=$1 o n
  o=$(sed 's/[][\\.*^$#]/\\&/g' <<<"$2"); n=$(sed 's/[\\&#]/\\&/g' <<<"$3")
  cp -p -- "$f" "$f.shim-tmp"
  sed "s#\"cwd\":\"$o\([/\"]\)#\"cwd\":\"$n\1#g" "$f" > "$f.shim-tmp" && mv -f -- "$f.shim-tmp" "$f"
}

# Reconnect git worktrees under <new> after their directory moved there from <old>.
repair_worktrees() {  # <old> <new>
  local old=$1 new=$2 g d gd main
  while IFS= read -r g; do
    d=$(dirname "$g")
    if [ -d "$g" ]; then   # a main worktree: this fixes its linked worktrees elsewhere
      git -C "$d" worktree repair >/dev/null 2>&1 || true
      continue
    fi
    gd=$(sed -n 's/^gitdir: //p' "$g")
    case "$gd" in
      "$old"/*/worktrees/*)   # its main worktree moved too: repair from there
        main=$new${gd#"$old"}; main=${main%/worktrees/*}; [ "${main##*/}" = .git ] && main=${main%/.git}
        set -- -C "$main" worktree repair "$d" ;;
      /*/worktrees/*) set -- -C "$d" worktree repair ;;
      *) continue ;;   # a submodule (relative gitdir): unaffected
    esac
    if git "$@" >/dev/null 2>&1; then echo "  repaired git worktree $d"
    else echo "  warning: git worktree repair failed for $d" >&2; fi
  done < <(find "$new" \( -name node_modules -o -name .venv \) -prune -o -name .git -print -prune 2>/dev/null)
}

# claude mv -d: move a directory and every session started in it or below.
cmd_mv_dir() {  # <old> <new>
  local old new moving eo en p f h sid rest in_tree n=0 cfg nkeys=0 i
  local -a sess=() homes=() dests=() mems=() skipped=() open=() bgs=()
  local -A bgset=() alive=() bginfo=() excluded=() tree=()
  old=$(abspath "$1"); new=$(abspath "$2")
  [ "$old" != / ] || die "refusing to move /"
  [ "$old" != "$new" ] || die "$old and $new are the same"
  case "$new/" in "$old"/*) die "can't move $old into itself" ;; esac
  if [ -d "$old" ] && [ ! -e "$new" ]; then
    [ -d "$(dirname "$new")" ] || die "no such directory: $(dirname "$new")"
    moving=1
  elif [ ! -e "$old" ] && [ -d "$new" ]; then
    moving=0   # already moved by hand: just bring the sessions along
  elif [ -d "$old" ]; then
    die "$new already exists; give the full new path, e.g. $new/$(basename "$old")"
  else
    die "no such directory: $old"
  fi

  while IFS= read -r sid; do [ -n "$sid" ] && bgset[$sid]=1; done \
    < <("$REAL" agents --json --all 2>/dev/null | jq -r '.[] | select(.kind == "background") | .sessionId' 2>/dev/null || true)
  for f in "$CLAUDE_HOME"/sessions/*.json; do
    [ -e "$f" ] || continue
    IFS=$'\t' read -r sid i h < <(jq -r '[.sessionId, .pid, .kind] | @tsv' "$f" 2>/dev/null) || continue
    kill -0 "$i" 2>/dev/null && alive[$sid]="$h $i"
  done

  # Project dirs for <old> and below share its encoded prefix, but so does a sibling like <old>-x.
  # The directories on disk tell them apart, and for subdirs that are gone, the sessions' recorded cwds.
  eo=$(encode "$old"); en=$(encode "$new")
  [ $moving = 1 ] && rest=$old || rest=$new
  while IFS=$'\t' read -r p h; do tree[x$p]=$h; done < <(
    find "$rest" \( -name .git -o -name node_modules -o -name .venv \) -prune -o -type d -print 2>/dev/null \
      | awk -v r="$rest" '{ s = substr($0, length(r) + 1); e = s; gsub(/[^A-Za-z0-9]/, "-", e); print e "\t" s }')
  shopt -s nullglob
  for p in "$PROJECTS/$eo" "$PROJECTS/$eo"-*; do
    [ -d "$p" ] || continue
    rest=${p#"$PROJECTS/$eo"}
    in_tree=""; [ -n "${tree[x$rest]+set}" ] && in_tree=1
    for f in "$p"/*.jsonl; do
      h=$(home_exact "$f") || continue
      case "$h" in "$old"|"$old"/*) in_tree=1 ;; *) excluded[$p]=1; [ -n "$in_tree" ] || in_tree=0 ;; esac
    done
    [ "$in_tree" = 0 ] && continue
    if [ -z "$in_tree" ]; then skipped+=("$p"); continue; fi
    for f in "$p"/*.jsonl; do
      sid=$(basename "$f" .jsonl)
      h=$(home_exact "$f") || h=""
      case "$h" in ""|"$old"|"$old"/*) ;; *) continue ;; esac
      [ -n "$h" ] || [ -z "${tree[x$rest]+set}" ] || h=$old${tree[x$rest]}
      [ "$en" = "$eo" ] || { [ ! -e "$PROJECTS/$en$rest/$sid.jsonl" ] && [ ! -e "$PROJECTS/$en$rest/$sid" ]; } \
        || die "$PROJECTS/$en$rest already has files for $sid"
      if [ -n "${bgset[$sid]:-}" ]; then
        [ -n "$h" ] || die "can't tell which dir under $old background session $sid runs in; move it on its own with claude mv first"
        bgs+=("${#sess[@]}")
      elif [ -n "${alive[$sid]:-}" ]; then
        open+=("$sid (${alive[$sid]% *} pid ${alive[$sid]#* })")
      fi
      sess+=("$f"); homes+=("$h"); dests+=("$PROJECTS/$en$rest")
    done
    [ -d "$p/memory" ] && [ -z "${excluded[$p]:-}" ] && mems+=("$p")
  done
  shopt -u nullglob
  [ ${#open[@]} -eq 0 ] || die "sessions under $old are open; close them first: $(printf '\n  %s' "${open[@]}")"

  cfg=${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json
  [ -f "$cfg" ] && nkeys=$(jq --arg o "$old" '[.projects // {} | keys[] | select(. == $o or startswith($o + "/"))] | length' "$cfg" 2>/dev/null || echo 0)

  if [ $moving = 1 ]; then echo "Move $old -> $new"; else echo "$old was already moved to $new; moving its sessions"; fi
  [ ${#sess[@]} -gt 0 ] || echo "  no sessions under $old"
  for i in "${!sess[@]}"; do
    f=${sess[$i]}; h=${homes[$i]}
    echo "  $(basename "$f" .jsonl)  \"$(title_of "$f")\"  ${h:-(dir unknown)}$([ -n "${bgset[$(basename "$f" .jsonl)]:-}" ] && echo '  [background]')"
  done
  if [ "$en" = "$eo" ]; then
    mems=()
    echo "  session files stay in projects/$eo* (both paths encode the same)"
  elif [ ${#sess[@]} -gt 0 ]; then
    echo "  session files: projects/$eo* -> projects/$en*"
  fi
  for p in "${mems[@]}"; do
    if [ -e "$PROJECTS/$en${p#"$PROJECTS/$eo"}/memory" ]; then echo "  memory: $p/memory stays (destination already has one)"
    else echo "  memory: $p/memory moves too"; fi
  done
  [ ${#bgs[@]} -gt 0 ] && echo "  background sessions are stopped, their jobs dropped (claude rm keeps transcripts), and restarted in the new dir"
  [ "$nkeys" -gt 0 ] && echo "  $cfg: $nkeys project entries (trust, allowed tools, MCP) renamed"
  echo "  recorded cwds in moved transcripts are rewritten to the new path; git worktrees under it are repaired"
  for p in "${skipped[@]}"; do echo "  skipped $p: can't tell if it's under $old (no such dir there now, and no session ran there)"; done
  [ $dry = 1 ] && { echo "(dry run, nothing moved)"; return; }

  for i in "${bgs[@]}"; do
    sid=$(basename "${sess[$i]}" .jsonl)
    bginfo[$sid]=$(bg_job "$sid")
    "$REAL" stop "${sid:0:8}" >/dev/null 2>&1 || true
    "$REAL" rm "${sid:0:8}" >/dev/null || die "claude rm ${sid:0:8} failed; nothing moved"
    [ -e "${sess[$i]}" ] || die "claude rm removed the transcript of $sid; nothing moved"
  done

  if [ $moving = 1 ]; then
    mv -- "$old" "$new" || die "moving $old failed; sessions not moved"
  fi
  for i in "${!sess[@]}"; do
    f=${sess[$i]}
    rewrite_cwd "$f" "$old" "$new"
    n=$((n+1))
    [ "$en" != "$eo" ] || continue
    mkdir -p "${dests[$i]}"
    mv -- "$f" "${dests[$i]}/"
    [ -d "${f%.jsonl}" ] && mv -- "${f%.jsonl}" "${dests[$i]}/"
  done
  for p in "${mems[@]}"; do
    i=$PROJECTS/$en${p#"$PROJECTS/$eo"}
    [ -e "$i/memory" ] || { mkdir -p "$i"; mv -- "$p/memory" "$i/"; }
  done
  for p in "$PROJECTS/$eo" "$PROJECTS/$eo"-*; do rmdir "$p" 2>/dev/null || true; done

  if [ "$nkeys" -gt 0 ]; then
    cp -p -- "$cfg" "$cfg.shim-tmp"
    jq --arg o "$old" --arg n "$new" '.projects |= with_entries(
        if .key == $o or (.key | startswith($o + "/")) then .key = $n + .key[($o | length):] else . end)' \
      "$cfg" > "$cfg.shim-tmp" && mv -f -- "$cfg.shim-tmp" "$cfg" \
      || { rm -f -- "$cfg.shim-tmp"; echo "  warning: couldn't update $cfg" >&2; }
  fi
  repair_worktrees "$old" "$new"

  local name dir; local -a lines flags
  for i in "${bgs[@]}"; do
    sid=$(basename "${sess[$i]}" .jsonl); dir=$new${homes[$i]#"$old"}
    mapfile -t lines <<<"${bginfo[$sid]}"
    name=${lines[0]}; flags=("${lines[@]:1}")
    [ -n "$name" ] || name=$(title_of "${dests[$i]}/$sid.jsonl")
    if (cd "$dir" && "$REAL" --bg --resume "$sid" "${flags[@]}" -n "$name" >/dev/null); then
      echo "  restarted \"$name\" in $dir (claude attach ${sid:0:8})"
    else
      echo "  warning: restarting failed; run: cd $dir && claude --bg --resume $sid -n \"$name\"" >&2
    fi
  done
  if [ $moving = 1 ]; then echo "Moved $old to $new with $n session(s)."; else echo "Moved $n session(s) to $new."; fi
}

cmd_mv() {
  local dry=0 dir=0
  while [ $# -gt 0 ]; do case "$1" in
    -n|--dry-run) dry=1 ;;
    -d|--dir) dir=1 ;;
    --from) FROM=${2%/}; case "$FROM" in /*) ;; *) FROM=$PWD/$FROM ;; esac; shift ;;   # may no longer exist
    -h|--help) sed -n '2,21p' "$SHIM_DIR/claude"; exit 0 ;;
    *) break ;; esac; shift; done
  if [ $dir = 1 ]; then
    [ $# -eq 2 ] || die "usage: claude mv [-n] -d <old dir> <new dir>"
    cmd_mv_dir "$1" "$2"; return
  fi
  [ $# -eq 2 ] || die "usage: claude mv [-n] [--from DIR] <session> <dir>"
  local f sid dest ddir bg=0 l name=""; local -a flags=()
  f=$(resolve "$1"); sid=$(basename "$f" .jsonl)
  dest=$(cd "$2" 2>/dev/null && pwd) || die "no such directory: $2"
  is_background "$sid" && bg=1
  l=$(live "$sid")
  [ -z "$l" ] || [ $bg = 1 ] || die "session $sid is open (${l% *} pid ${l#* }); close it first"
  ddir=$PROJECTS/$(encode "$dest")
  [ "$ddir" != "$(dirname "$f")" ] || die "already in $dest"
  [ ! -e "$ddir/$sid.jsonl" ] && [ ! -e "$ddir/$sid" ] || die "$ddir already has files for $sid"
  if [ $bg = 1 ]; then
    { IFS= read -r name; while IFS= read -r x; do flags+=("$x"); done; } < <(bg_job "$sid")
    [ -n "$name" ] || name=$(title_of "$f")
  fi

  echo "Move to $dest:"; describe "$f"
  if [ $bg = 1 ]; then
    echo "  background session \"$name\": stop it, drop its job (claude rm keeps the transcript), move, restart in $dest"
    [ -n "$l" ] && echo "  it is running now (pid ${l#* }); any turn in progress is interrupted"
  fi
  echo "  $f -> $ddir/"
  [ -d "${f%.jsonl}" ] && echo "  ${f%.jsonl}/ -> $ddir/"
  [ $dry = 1 ] && { echo "(dry run, nothing moved)"; return; }

  if [ $bg = 1 ]; then
    "$REAL" stop "${sid:0:8}" >/dev/null 2>&1 || true
    "$REAL" rm "${sid:0:8}" >/dev/null || die "claude rm ${sid:0:8} failed; nothing moved"
    [ -e "$f" ] || die "claude rm removed the transcript; nothing left to move"
  fi

  mkdir -p "$ddir"
  mv -- "$f" "$ddir/"
  [ -d "${f%.jsonl}" ] && mv -- "${f%.jsonl}" "$ddir/"
  rmdir "$(dirname "$f")" 2>/dev/null || true

  if [ $bg = 1 ]; then
    (cd "$dest" && "$REAL" --bg --resume "$sid" "${flags[@]}" -n "$name" >/dev/null) \
      || die "moved, but restarting failed; run: cd $dest && claude --bg --resume $sid -n \"$name\""
    echo "Moved and restarted \"$name\" in $dest (claude attach ${sid:0:8})"
  else
    echo "Moved. Resume with: cd $dest && claude --resume $sid"
  fi
}

cmd=${1:-}
REAL=$(real_claude)
case "$cmd" in
  rm)     shift; cmd_rm "$@" ;;
  mv)     shift; cmd_mv "$@" ;;
  search) shift; exec "$LIBEXEC/claude-search" "$@" ;;
  ls)     shift; exec "$LIBEXEC/claude-search" --list "$@" ;;
  shim)   echo "claude shim $(cat "$SHIM_DIR/../VERSION" 2>/dev/null || echo dev) at $SHIM_DIR; real claude: $REAL" ;;
  *)      exec "$REAL" "$@" ;;
esac
