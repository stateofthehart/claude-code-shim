#!/usr/bin/env bash
# claude search - search Claude Code session transcripts for patterns
#
# Usage: claude search [options] PATTERN [PATTERN ...]
#   -o, --or          OR mode: match any pattern (default: AND, all must match)
#   -i, --ignore-case Case-insensitive matching
#   -p, --preview     Show first user prompt
#   -L, --last        Show last user prompt and last assistant reply
#   -s, --snippets    Show matched-text snippets with the regex highlighted
#   -a, --all         Show everything (preview + last + snippets)
#   -n, --num N       Max snippets per pattern (default 3)
#   -c, --context N   Chars of context around each snippet match (default 50)
#   -w, --width N     Truncation width for preview/last (default 160)
#   -l, --limit N     Limit output to N sessions
#   -d, --dir PATH    Restrict to sessions started in PATH (e.g. -d . or -d ~/services/onepass)
#   -D GLOB           Restrict to project dirs matching shell GLOB (raw ~/.claude/projects names)
#   --no-color        Disable color output (auto-disabled when not a TTY)
#   -h, --help        Show this help
#
# Patterns are extended regex (grep -E). Matches the raw JSONL transcript text.
# Each result shows the session id; pass it to claude --resume, claude rm or claude mv.

set -euo pipefail

# shellcheck source=portable.sh
. "$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/portable.sh"

# Use the real grep binary — bypass any shell function wrappers (Claude Code
# wraps grep with ugrep, which rejects regexes like ".{0,50}").
grep() { command grep "$@"; }

PROJECTS_DIR="${CLAUDE_PROJECTS_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects}"
RS=$'\x1e'    # field separator (non-whitespace so bash 'read' preserves empties)
UNIT=$'\x1f'  # snippet separator within a field

mode=and
ignore=0
preview=0
show_last=0
snippets=0
snip_count=3
context=50
limit=0
width=160
dir_glob=""
color_opt=auto

while [[ $# -gt 0 ]]; do
  case "$1" in
    -o|--or) mode=or; shift ;;
    -i|--ignore-case) ignore=1; shift ;;
    -p|--preview) preview=1; shift ;;
    -L|--last) show_last=1; shift ;;
    -s|--snippets) snippets=1; shift ;;
    -a|--all) preview=1; show_last=1; snippets=1; shift ;;
    -n|--num) snip_count="$2"; shift 2 ;;
    -c|--context) context="$2"; shift 2 ;;
    -w|--width) width="$2"; shift 2 ;;
    -l|--limit) limit="$2"; shift 2 ;;
    -d|--dir) dir_glob=$(cd "$2" && pwd -P | sed 's#[^A-Za-z0-9]#-#g') || exit 2; shift 2 ;;
    -D) dir_glob="$2"; shift 2 ;;
    --no-color) color_opt=never; shift ;;
    --color) color_opt=always; shift ;;
    -h|--help)
      sed -n '2,22p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    --) shift; break ;;
    -*) echo "unknown option: $1" >&2; exit 2 ;;
    *) break ;;
  esac
done

if [[ $# -lt 1 ]]; then
  echo "error: need at least one pattern (try -h)" >&2
  exit 2
fi

# Color setup
use_color=0
case "$color_opt" in
  always) use_color=1 ;;
  never)  use_color=0 ;;
  auto)   [[ -t 1 ]] && use_color=1 ;;
esac

if [[ $use_color -eq 1 ]]; then
  C_TIME=$'\e[36m'      # cyan
  C_DIR=$'\e[1;32m'     # bold green
  C_LBL=$'\e[1;34m'     # bold blue
  C_TITLE=$'\e[1;33m'   # bold yellow
  C_DIM=$'\e[2m'        # dim
  C_MATCH_LBL=$'\e[1;35m' # bold magenta
  C_OFF=$'\e[0m'
  GREP_COLOR=always
  # Make grep's match highlight stand out (red bg, bold)
  export GREP_COLORS='mt=1;41'
else
  C_TIME=""; C_DIR=""; C_LBL=""; C_TITLE=""; C_DIM=""; C_MATCH_LBL=""; C_OFF=""
  GREP_COLOR=never
fi

patterns=("$@")
gflags=(-E -l)
[[ $ignore -eq 1 ]] && gflags+=(-i)

# Collect candidate session files
shopt -s nullglob
if [[ -n "$dir_glob" ]]; then
  files=("$PROJECTS_DIR"/$dir_glob/*.jsonl)
else
  files=("$PROJECTS_DIR"/*/*.jsonl)
fi
shopt -u nullglob

if [[ ${#files[@]} -eq 0 ]]; then
  echo "no session files found under $PROJECTS_DIR" >&2
  exit 1
fi

# Filter files by patterns (against raw JSONL)
matched=()
if [[ $mode == or ]]; then
  joined=$(printf '%s|' "${patterns[@]}")
  joined="${joined%|}"
  while IFS= read -r f; do matched+=("$f"); done < <(grep "${gflags[@]}" -- "$joined" "${files[@]}" 2>/dev/null || true)
else
  current=$(grep "${gflags[@]}" -- "${patterns[0]}" "${files[@]}" 2>/dev/null || true)
  for ((i=1; i<${#patterns[@]}; i++)); do
    [[ -z "$current" ]] && break
    current=$(printf '%s\n' "$current" | tr '\n' '\0' | xargs -0 grep "${gflags[@]}" -- "${patterns[$i]}" 2>/dev/null || true)
  done
  while IFS= read -r f; do [[ -n "$f" ]] && matched+=("$f"); done <<< "$current"
fi

if [[ ${#matched[@]} -eq 0 ]]; then
  echo "no matches" >&2
  exit 1
fi

trunc() { tr '\n\t' '  ' | tr -s ' ' | cut -c1-"$width" | sed 's/[[:space:]]*$//'; }
sanitize_tabs() { tr '\t' ' '; }

# Pull just the conversational text (user prompts + assistant replies) from a JSONL,
# one turn per output line. Keeping newlines is critical: grep's .{0,N} context
# regex becomes pathological on very long single lines.
extract_text() {
  jq -rc '
    def flat:
      if type=="string" then .
      elif type=="array" then (map(.text // "") | join(" "))
      else "" end;
    if .type=="user" or .type=="assistant" then (.message.content | flat)
    else empty end
  ' "$1" 2>/dev/null
}

# Build TSV: mtime_epoch \t mtime_iso \t cwd \t session \t title \t first \t lastp \t lastr \t snippets(UNIT-separated)
rows=$(
  for f in "${matched[@]}"; do
    mtime_epoch=$(mtime "$f")
    mtime_iso=$(fmt_epoch "$mtime_epoch" '%Y-%m-%d %H:%M:%S')
    cwd=$(grep -m1 -o '"cwd":"[^"]*"' "$f" | head -1 | sed 's/^"cwd":"//;s/"$//')
    [[ -z "$cwd" ]] && cwd="(unknown)"

    title=$(grep '"type":"custom-title"' "$f" 2>/dev/null | tail -1 \
      | jq -r '.customTitle // ""' 2>/dev/null | sanitize_tabs || true)
    [[ -z "$title" ]] && title=$(grep -m1 '"type":"ai-title"' "$f" 2>/dev/null \
      | jq -r '.aiTitle // ""' 2>/dev/null | sanitize_tabs || true)

    first=""
    if [[ $preview -eq 1 ]]; then
      first=$(grep -m1 '"type":"user"' "$f" \
        | jq -r 'if (.message.content|type)=="string" then .message.content
                 elif (.message.content|type)=="array" then ((.message.content[]?|select(.type=="text").text) // "")
                 else "" end' 2>/dev/null | trunc)
    fi

    last_prompt=""
    last_reply=""
    if [[ $show_last -eq 1 ]]; then
      last_prompt=$(grep '"type":"last-prompt"' "$f" 2>/dev/null | tail -1 \
        | jq -r '.lastPrompt // ""' 2>/dev/null | trunc)
      last_reply=$(jq -rc 'select(.type=="assistant") | .message.content // []
        | if type=="array" then (map(select(.type=="text") | .text) | join(" "))
          else . end' "$f" 2>/dev/null \
        | awk 'NF' | tail -1 | trunc)
    fi

    snip_field=""
    if [[ $snippets -eq 1 ]]; then
      # Prefer matches from conversational text (cleaner). Fall back to raw
      # JSONL so we always show the match even if it was inside tool output.
      # Extract once per file, write to a temp file so multiple pattern greps
      # don't re-run jq. Saves a lot of time when -s is combined with many patterns.
      text_file=$(mktemp "${TMPDIR:-/tmp}/claude-search.XXXXXX")
      extract_text "$f" > "$text_file"
      sflags=(-ohE "--color=$GREP_COLOR")
      [[ $ignore -eq 1 ]] && sflags+=(-i)
      for p in "${patterns[@]}"; do
        ms=$(grep "${sflags[@]}" -- ".{0,$context}$p.{0,$context}" "$text_file" 2>/dev/null \
              | awk '!seen[$0]++' | head -n "$snip_count")
        if [[ -z "$ms" ]]; then
          # Match was likely in tool output / metadata. Grep raw JSONL as a fallback,
          # but cap the context tighter to keep regex backtracking under control.
          ms=$(grep "${sflags[@]}" -- ".{0,20}$p.{0,20}" "$f" 2>/dev/null \
                | awk '!seen[$0]++' | head -n "$snip_count")
        fi
        if [[ -n "$ms" ]]; then
          while IFS= read -r m; do
            [[ -z "$m" ]] && continue
            m=$(printf '%s' "$m" | sanitize_tabs)
            [[ -n "$snip_field" ]] && snip_field+="$UNIT"
            snip_field+="$m"
          done <<< "$ms"
        fi
      done
      rm -f "$text_file"
    fi

    printf '%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s\n' \
      "$mtime_epoch" "$RS" "$mtime_iso" "$RS" "$cwd" "$RS" "$f" "$RS" \
      "$title" "$RS" "$first" "$RS" "$last_prompt" "$RS" "$last_reply" "$RS" "$snip_field"
  done | sort -t "$RS" -k1,1nr
)

if [[ $limit -gt 0 ]]; then
  rows=$(printf '%s\n' "$rows" | head -n "$limit")
fi

# Pretty print
while IFS="$RS" read -r _epoch mtime cwd sess title first lastp lastr snips; do
  [[ -z "$mtime" ]] && continue
  printf '%s%s%s  %s%s%s\n' "$C_TIME" "$mtime" "$C_OFF" "$C_DIR" "$cwd" "$C_OFF"
  [[ -n "$title" ]]                          && printf '  %stitle:%s   %s%s%s\n'   "$C_LBL" "$C_OFF" "$C_TITLE" "$title" "$C_OFF"
  printf '  %ssession:%s %s%s%s\n' "$C_LBL" "$C_OFF" "$C_DIM" "$(basename "$sess" .jsonl)" "$C_OFF"
  [[ $preview -eq 1   && -n "$first" ]]      && printf '  %sfirst:%s   %s\n'        "$C_LBL" "$C_OFF" "$first"
  [[ $show_last -eq 1 && -n "$lastp" ]]      && printf '  %slast >:%s  %s\n'        "$C_LBL" "$C_OFF" "$lastp"
  [[ $show_last -eq 1 && -n "$lastr" ]]      && printf '  %slast <:%s  %s\n'        "$C_LBL" "$C_OFF" "$lastr"
  if [[ -n "$snips" ]]; then
    while IFS= read -r snip; do
      [[ -z "$snip" ]] && continue
      printf '  %smatch:%s   %s\n' "$C_MATCH_LBL" "$C_OFF" "$snip"
    done < <(printf '%s' "$snips" | tr "$UNIT" '\n')
  fi
  echo
done <<< "$rows"
